#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") -m <vertical|1|horizontal|2>

Options:
-m MONITOR  Monitor to use:
            Allowed values:
            vertical
            horizontal
            1
            2
EOF
}

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

WALLPAPER_DIR="/home/matt/repos/wallpapers"

while getopts ":m:h" opt; do
  case "$opt" in
    m)
      mode="$OPTARG"
      ;;
    h)
      usage
      exit 0
      ;;
    :)
      echo "Error -$OPTARG requires an argument." >&2
      usage
      exit 2
      ;;
    \?)
      echo "Error: invalid option -$OPTARG" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ -f /etc/os-release ]]; then
  . /etc/os-release
  case "$ID" in
    arch)
      echo "Arch Linux"
      ;;
    pop)
      echo "Pop OS"
      ;;
    *)
      echo "Unknown distro: $ID"
      exit 1
      ;;
  esac
fi

shift $((OPTIND - 1))

case "$mode" in
  vertical|horizontal|1|2)
    ;;
  *)
    echo "Error: invalid mode '$mode'. Use vertical, horizontal, 1 or 2." >&2
    usage
    exit 2
    ;;
esac

# OPTIONS=($(ls $WALLPAPER_DIR))
mapfile -t OPTIONS < <(ls $WALLPAPER_DIR)

select option in "${OPTIONS[@]}"; do
  echo "You picked: $option"
  break
done

case "$mode" in
  vertical|1)
    cp "$WALLPAPER_DIR/$option" /home/matt/wallpaper-vertical.jpg
    ;;
  horizontal|2)
    cp "$WALLPAPER_DIR/$option" /home/matt/wallpaper-horizontal.jpg
    ;;
esac

if [[ $ID == "arch" ]]; then
  pkill -x hyprpaper || true
  sleep 0.5
  hyprpaper &
elif [[ $ID == "pop" ]]; then
  killall cosmic-bg
fi
